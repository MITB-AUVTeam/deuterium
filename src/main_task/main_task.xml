<root BTCPP_format="4" main_tree_to_execute="Main_Task">

    <!-- ================= Main Execution Tree ================= -->
    <BehaviorTree ID="Main_Task">
        <Sequence>
            <SubTree ID="StartGate" _shared_blackboard="true"/>
            <!-- <SubTree ID="AlignObject" _shared_blackboard="true"/> -->
        </Sequence>
    </BehaviorTree>

    <!-- ================= Start Gate ================= -->
    <BehaviorTree ID="StartGate">
        <Sequence name="start_gate_sequence">
            <AllSystemsOK name="check_systems" timeout_s="20.0"/>
            <DiveToDepth target_depth="0.4"/>
            <Do360Turn success_when_seen="search_and_rescue" max_turns="2"/>
            <Fallback name="find_search_rescue">
                <IsObjectSeen object="search_and_rescue"/>
                <Do360Turn success_when_seen="search_and_rescue" max_turns="2"/>
            </Fallback>
            <AlignAndApproachObject object="search_and_rescue"/>
        </Sequence>
    </BehaviorTree>

    <!-- ================= Align Object ================= -->
    <BehaviorTree ID="AlignObject">
        <Sequence name="align_object_sequence">
            <Fallback name="find_pole">
                <IsObjectSeen object="search_and_rescue"/>
                <Do360Turn success_when_seen="search_and_rescue"/>
            </Fallback>
            <AlignAndApproachObject object="search_and_rescue"/>
        </Sequence>
    </BehaviorTree>

    <!-- ================= Test Trees ================= -->
    <BehaviorTree ID="TestAlign">
        <Sequence name="test_align_sequence">
            <AlignWithObject object="main_gate"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="TestSurge">
        <Sequence name="test_surge_sequence">
            <SurgeForwardDistance distance="2.0"/>
        </Sequence>
    </BehaviorTree>

    <!-- ================= Node Declarations ================= -->
    <TreeNodesModel>
        <Action ID="AllSystemsOK">
            <input_port name="timeout_s" type="double" default="20.0"/>
        </Action>
        <Condition ID="IsObjectSeen">
            <input_port name="object" type="std::string"/>
        </Condition>
        <Condition ID="FindAnyObject">
            <input_port name="objects" type="std::string"/>
            <output_port name="found_object" type="std::string"/>
        </Condition>
        <Action ID="DiveToDepth">
            <input_port name="target_depth" type="double"/>
        </Action>
        <Action ID="Do360Turn">
            <input_port name="success_when_seen" type="std::string"/>
            <input_port name="max_turns" type="int" default="2"/>
        </Action>
        <Action ID="Do360TurnAny">
            <input_port name="objects" type="std::string"/>
            <output_port name="found_object" type="std::string"/>
        </Action>
        <Action ID="CenterObject">
            <input_port name="object" type="std::string"/>
        </Action>
        <Action ID="AlignWithObject">
            <input_port name="object" type="std::string"/>
        </Action>
        <Action ID="AlignAndApproachObject">
            <input_port name="object" type="std::string"/>
        </Action>
        <Action ID="StayStill">
            <input_port name="duration" type="double" default="3.0"/>
        </Action>
        <Action ID="SurgeForwardDistance">
            <input_port name="distance" type="double" default="1.0"/>
        </Action>
        <Action ID="SaveCurrentYaw"/>
        <Action ID="AlignToLockedYaw"/>
    </TreeNodesModel>

</root>
